{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": " › ",
        "key": {
            "width": 14
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "key": "  ",
            "format": "{user-name} @ {host-name}",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "  Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "datetime",
            "key": "  Date",
            "keyColor": "cyan",
            "format": "{day-pretty}/{month-pretty}/{year} {hour-pretty}:{minute-pretty}"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
