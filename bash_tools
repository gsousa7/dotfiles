# Loader: sources every module in bash_tools.d/ (env, aliases, git, tmux,
# kubernetes, functions, media, customization, cheatsheet, help) in order.
_dotfiles_tools_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/bash_tools.d"

for _dotfiles_tool_file in "$_dotfiles_tools_dir"/*.sh; do
    . "$_dotfiles_tool_file"
done
unset _dotfiles_tools_dir _dotfiles_tool_file

# Load external files - uncomment if you have them
#. ~/.bash_aliases 2>/dev/null || true
#. ~/.bashrc.local 2>/dev/null || true

# load completion
. /etc/bash/bash_completion 2>/dev/null || . ~/.bash_completion 2>/dev/null

true
